# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# Training artifacts
output/
logs/
checkpoints/
*.pth
*.ckpt
*.npz
*.png
*.gif
*.mp4

# Mesh / FEM scratch files
*.msh
*.vtk
*.vtu
*.xdmf

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editor / OS
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/

# Privatized / scratch (mirror TensorMesh convention)
_private/

# uv lockfile (project uses pip, not uv)
uv.lock

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml

# Compiled documents. Figure PDFs (e.g. paper/figures/*.pdf) are LaTeX *inputs*
# and stay tracked, so these are listed by name rather than globbing *.pdf.
paper/main.pdf
paper/old_versions/*.pdf
notes/paper_story/paper_story_experiments.pdf
