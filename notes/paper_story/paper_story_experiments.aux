\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Least-squares loss and spectral preconditioning}{1}{subsection.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Poisson, least-squares loss. Validation error vs.\ epoch as the preconditioner strength $t$ is swept from $0$ (identity) to $1$ ($A^{-1}$), plus the multigrid V-cycle and the data-driven reference. Unpreconditioned training stalls; full / multigrid preconditioning recovers the data-driven gold standard.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:pls-overlay}{{1}{2}{Poisson, least-squares loss. Validation error vs.\ epoch as the preconditioner strength $t$ is swept from $0$ (identity) to $1$ ($\Ainv $), plus the multigrid V-cycle and the data-driven reference. Unpreconditioned training stalls; full / multigrid preconditioning recovers the data-driven gold standard}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The same runs, final validation error against the condition number of the preconditioned operator. Error grows monotonically with conditioning --- the mechanism, made explicit.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:pls-collapse}{{2}{3}{The same runs, final validation error against the condition number of the preconditioned operator. Error grows monotonically with conditioning --- the mechanism, made explicit}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}Deep Ritz: the variational formulation is milder}{3}{subsection.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Poisson, Deep Ritz (variational) loss. Because the conditioning is only $h^{-2}$, training already succeeds unpreconditioned on $64^2$; preconditioning gives a modest speed-up.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:deepritz-overlay}{{3}{4}{Poisson, Deep Ritz (variational) loss. Because the conditioning is only $h^{-2}$, training already succeeds unpreconditioned on $64^2$; preconditioning gives a modest speed-up}{figure.3}{}}
