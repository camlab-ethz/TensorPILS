\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Test relative $L^2$ vs.\ training-set size at a fixed optimisation budget. Error decreases with dataset size and saturates at the infinite-data (streaming, never-revisit) limit, the dashed black line.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:data-scaling}{{4}{5}{Test relative $L^2$ vs.\ training-set size at a fixed optimisation budget. Error decreases with dataset size and saturates at the infinite-data (streaming, never-revisit) limit, the dashed black line}{figure.4}{}}
